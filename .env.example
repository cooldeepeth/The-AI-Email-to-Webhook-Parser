# ---------------------------------------------------------------------
# thook - environment variables
# Copy to .env.local for local development.
# ---------------------------------------------------------------------

# --- Supabase (server-side only; SERVICE ROLE bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postmark inbound webhook protection ---
# Postmark does not sign inbound payloads. Put this secret in the inbound
# webhook URL as HTTP Basic auth (https://user:SECRET@host/api/v1/inbound-email)
# or as ?token=SECRET. The route also accepts a Bearer / X-Postmark-Token header.
POSTMARK_INBOUND_WEBHOOK_TOKEN=generate-a-long-random-string

# Optional: the inbound domain, used to disambiguate the recipient slug
# when an email has multiple recipients (e.g. forwarded mail).
INBOUND_EMAIL_DOMAIN=inbound.thook.io

# --- AI structuring engine ---
# "anthropic" (default) or "openai"
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Timeouts (ms) ---
AI_TIMEOUT_MS=45000
WEBHOOK_TIMEOUT_MS=15000

# --- Delivery retries (cron worker + manual replay) ---
# Set this in Vercel so Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-another-long-random-string
MAX_DELIVERY_RETRIES=5
# Minutes to wait before attempt N, indexed by retry_count (last value reused).
RETRY_BACKOFF_MINUTES=1,5,15,60,180
RETRY_BATCH_SIZE=25
